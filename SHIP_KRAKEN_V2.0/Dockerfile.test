# Kraken v2.0 Ship Package Test Container
# Tests the SHIP_KRAKEN_V2.0 package

FROM debian:bookworm-slim

ENV HOME=/root
ENV PATH=/root/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV NODE_PATH=/usr/local/lib/node_modules

WORKDIR /root

# Install base dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    ca-certificates \
    python3 \
    python3-pip \
    unzip \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install bun
RUN curl -fsSL https://bun.sh/install | bash

# Install opencode globally via npm (to /usr/local/lib/node_modules)
RUN npm install -g opencode-ai@latest

# Create plugin directories
RUN mkdir -p /root/.config/opencode
RUN mkdir -p /root/.config/opencode/plugins
RUN mkdir -p /root/.shark
RUN mkdir -p /root/.manta

# Set HOME for the opencode workspace
ENV HOME=/root

# Copy kraken-agent plugin (from ship package build/)
COPY build/index.js /root/.config/opencode/plugins/kraken-agent/dist/index.js
COPY kraken-agent/dist/node_modules /root/.config/opencode/plugins/kraken-agent/dist/node_modules

# Copy kraken-agent source/wrappers for reference
COPY kraken-agent-source/wrappers /root/.config/opencode/plugins/kraken-agent/wrappers

# Copy subagent-manager plugin
COPY subagent-manager/dist /root/.config/opencode/plugins/subagent-manager/dist
COPY subagent-manager/wrappers /root/.config/opencode/plugins/subagent-manager/wrappers

# Copy shark and manta agents
COPY shark-agent-src /root/.config/opencode/plugins/shark-agent
COPY manta-agent-src /root/.config/opencode/plugins/manta-agent

# Copy opencode config
COPY opencode-config.json /root/.config/opencode/opencode.json

# Set permissions
RUN chmod -R 755 /root/.config/opencode/
RUN chmod 644 /root/.config/opencode/opencode.json

# Verify plugin files exist
RUN ls -la /root/.config/opencode/plugins/kraken-agent/dist/
RUN ls -la /root/.config/opencode/plugins/kraken-agent/wrappers/
RUN ls -la /root/.config/opencode/plugins/subagent-manager/

# Test: Check for hardcoded paths in bundle
RUN echo "Checking for hardcoded paths in bundle..." && \
    (grep "/home/leviathan" /root/.config/opencode/plugins/kraken-agent/dist/index.js && echo "ERROR: Found hardcoded paths!" || echo "OK: No hardcoded paths found")

CMD ["/bin/bash"]
