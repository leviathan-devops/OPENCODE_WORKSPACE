  "mechanical_verification": "Call shark-status tool, verify it returns structured JSON with variant=macro, brain, gate, iteration, evidence status",
  "difficulty": "P0",
  "time_estimate": "15 seconds",

  "prompt": "call shark-status",

  "expected_behavior": "Returns JSON with variant=macro, brain, currentGate, iteration, gateStatuses, evidenceStatus, verifyAttempts",

  "verification_steps": [
    {
      "step": 1,
      "action": "call shark-status",
      "expected": "JSON object with all required fields",
      "mechanical_pass": "Output contains 'variant' with value 'macro'"
    },
    {
      "step": 2,
      "action": "inspect currentGate field",
      "expected": "One of: plan, build, test, verify, audit, delivery",
      "mechanical_pass": "currentGate is valid gate name"
    },
    {
      "step": 3,
      "action": "inspect iteration field",
      "expected": "Format V1.0, V1.1, etc.",
      "mechanical_pass": "iteration matches pattern V\\d+\\.\\d+"
    },
    {
      "step": 4,
      "action": "inspect brain field",
      "expected": "Shows execution brain or active brains array",
      "mechanical_pass": "brain shows execution mode"
    }
  ],

  "pass_criteria": {
    "status_returns": "shark-status returns JSON without error",
    "variant_correct": "variant field = 'macro'",
    "gate_valid": "currentGate is valid gate name",
    "iteration_format": "iteration matches V\\d+\\.\\d+"
  },

  "failure_modes": {
    "tool_not_found": "shark-status tool not accessible",
    "wrong_variant": "variant shows 'micro' instead of 'macro'",
