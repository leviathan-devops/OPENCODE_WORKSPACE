{
  "name": "spider-agent-prototype",
  "version": "0.1.0",
  "description": "Spider Agent Prototype - Test plugin for template validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build --no-bundle src/index.ts --outdir dist --target bun --format esm",
    "build:watch": "bun build --no-bundle src/index.ts --outdir dist --target bun --format esm --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test tests/integration"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.3.6",
    "@opencode-ai/sdk": "^1.3.6"
  },
  "dependencies": {
    "zod": "^3.23.8",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.3.6",
    "@opencode-ai/sdk": "^1.3.6",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
