"""

@app.get("/", response_class=HTMLResponse)
async def root():
    return CHAT_HTML

@app.post("/api/chat")
async def chat(request: Request):
    body = await request.json()
    message = body.get("message", "")
    session_id = body.get("session_id")
    
    if not message:
        raise HTTPException(status_code=400, detail="No message provided")
    
    # Generate session ID if not provided
    if not session_id:
        session_id = f"web_{os.urandom(8).hex()}"
    
    # Store in sessions
    if session_id not in sessions:
        sessions[session_id] = []
    sessions[session_id].append({"role": "user", "content": message})
    
    # Simple AI response using MiniMax if available
    response_text = "I'm Hermes 2nd-Brain, running in the cloud! (Full AI integration coming soon)"
    
    if MINIMAX_API_KEY:
        try:
            import httpx
            messages = [{"role": "system", "content": "You are Hermes 2nd-Brain, an AI assistant with full context of the user's life and work."}]
            for msg in sessions[session_id][-10:]:
                messages.append({"role": msg["role"], "content": msg["content"]})
            messages.append({"role": "user", "content": message})
            
            async with httpx.AsyncClient(timeout=60.0) as client:
                resp = await client.post(
                    "https://api.minimax.io/v1/chat/completions",
                    headers={"Authorization": f"Bearer {MINIMAX_API_KEY}", "Content-Type": "application/json"},
                    json={"model": "MiniMax-M2.7", "messages": messages, "max_tokens": 1000, "temperature": 0.7}
                )
                if resp.status_code == 200:
                    response_text = resp.json()["choices"][0]["message"]["content"]
        except Exception as e:
            response_text = f"AI error: {str(e)[:100]}"
    
    sessions[session_id].append({"role": "assistant", "content": response_text})
    
    return {"response": response_text, "session_id": session_id}

@app.get("/health")
async def health():
    return {"status": "ok", "service": "hermes-web-chat"}

if __name__ == "__main__":
    print(f"[Hermes Web Chat] Starting on port {HERMES_PORT}")
    uvicorn.run(app, host="0.0.0.0", port=HERMES_PORT, log_level="info")
PYEOF

EXPOSE 8080

CMD ["python3", "/app/web_chat_server.py"]
