# Minimal Cloud Hermes - Simple approach
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HERMES_HOME=/opt/hermes

# Install essentials
RUN apt-get update && apt-get install -y \
    python3 python3-pip git curl wget vim \
    && rm -rf /var/lib/apt/lists/*

# Install Hermes from source
RUN git clone https://github.com/leviathan-devops/hermes-agent.git /opt/hermes \
    && cd /opt/hermes && pip3 install -e . \
    && ln -s /opt/hermes/hermes /usr/local/bin/hermes

# Copy profile
RUN mkdir -p /opt/hermes/profiles/2nd-brain
COPY profiles/2nd-brain/ /opt/hermes/profiles/2nd-brain/

# Keep container alive
CMD ["sleep", "infinity"]
