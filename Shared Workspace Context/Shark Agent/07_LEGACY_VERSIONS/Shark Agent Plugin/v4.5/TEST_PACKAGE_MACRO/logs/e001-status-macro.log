#!/bin/bash
#
# Shark Macro Agent — Test Execution Script
# Package: shark-macro-test-package-v1
# Agent: shark-macro
#

TEST_DIR="/home/leviathan/OPENCODE_WORKSPACE/Shared Workspace Context/Shark Agent Plugin/v4.5/TEST_PACKAGE_MACRO"
EXERCISES_DIR="$TEST_DIR/EXERCISES"
RESULTS_FILE="$TEST_DIR/EXERCISE_RESULTS.json"
LOGS_DIR="$TEST_DIR/logs"

mkdir -p "$LOGS_DIR"

echo "=============================================="
echo "Shark Macro Agent — Test Package v1.0"
echo "=============================================="
echo ""

# Initialize results
cat > "$RESULTS_FILE" << 'EOF'
{
  "package_id": "shark-macro-test-package-v1",
  "version": "1.0",
  "date": "2026-04-07",
  "agent": "shark-macro",
  "executor": "DEV_OPS_MANAGER",
  "exercises_completed": [],
  "exercises_passed": [],
  "exercises_failed": [],
  "results": []
}
EOF

# Exercise list
EXERCISES=(
  "e001-status-macro"
  "e002-gate-criteria"
  "e003-guardian-dangerous-command"
  "e004-guardian-zone-check"
  "e005-gate-auto-advance-build"
  "e006-gate-auto-advance-test"
  "e008-iteration-loop-init"
  "e009-self-rejection-t1-prompt"
  "e010-execution-brain-role"
  "e011-gate-manual-evaluate"
  "e012-gate-manual-advance"
  "e013-iteration-escalation-detect"
  "e014-system-transform-hook"
  "e015-state-persistence-checkpoint"
  "e016-evidence-collection"
  "e017-verify-attempts-counter"
  "e018-gate-status-all"
  "e019-guardrails-enforcement"
  "e020-error-handling-complete"
)

PASS_COUNT=0
FAIL_COUNT=0

echo "Exercises to run: ${#EXERCISES[@]}"
echo ""

for exercise in "${EXERCISES[@]}"; do
  EXERCISE_FILE="$EXERCISES_DIR/${exercise}.json"

  if [ ! -f "$EXERCISE_FILE" ]; then
    echo "  [SKIP] $exercise — exercise file not found"
    continue
  fi

  echo "----------------------------------------------"
  echo "Running: $exercise"
  echo "----------------------------------------------"

  # Read exercise name
  EX_NAME=$(cat "$EXERCISE_FILE" | grep '"name"' | head -1 | cut -d'"' -f4)
  COMPONENT=$(cat "$EXERCISE_FILE" | grep '"component"' | head -1 | cut -d'"' -f4)
  DIFFICULTY=$(cat "$EXERCISE_FILE" | grep '"difficulty"' | head -1 | cut -d'"' -f4)

  echo "  Name: $EX_NAME"
  echo "  Component: $component"
  echo "  Difficulty: $DIFFICULTY"

  # Run exercise via opencode
  LOG_FILE="$LOGS_DIR/${exercise}.log"
  timeout 60 opencode run "@shark-macro $(cat $EXERCISE_FILE | grep '"prompt"' | cut -d'"' -f4 | head -1)" > "$LOG_FILE" 2>&1

  if [ $? -eq 0 ]; then
    echo "  [PASS] Exercise completed"
    PASS_COUNT=$((PASS_COUNT + 1))
  else
    echo "  [FAIL] Exercise failed or timed out"
    FAIL_COUNT=$((FAIL_COUNT + 1))
  fi

  echo ""
done

echo "=============================================="
echo "Test Run Complete"
echo "=============================================="
echo "Passed: ${PASS_COUNT}"
echo "Failed: ${FAIL_COUNT}"
echo ""
echo "Results written to: $RESULTS_FILE"
echo "Logs written to: $LOGS_DIR/"

exit 0
