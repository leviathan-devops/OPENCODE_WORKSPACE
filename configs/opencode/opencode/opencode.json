    "0-local-vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local vLLM",
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "/home/leviathan/OPENCODE_WORKSPACE/models/Qwen2.5-Coder-7B-Instruct-AWQ": {
          "name": "Qwen 2.5 Coder 7B AWQ (Local 32K)",
          "limit": {
