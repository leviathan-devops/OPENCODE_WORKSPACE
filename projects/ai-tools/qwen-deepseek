#!/usr/bin/env bash
# Launch Qwen Code with DeepSeek API backend
# Usage: qwen-deepseek [--yolo] [other args...]

set -e

echo "🚀 Qwen Code → DeepSeek API (deepseek-chat)"

# Launch Qwen Code with DeepSeek environment variables
OPENAI_BASE_URL="https://api.deepseek.com/v1" \
OPENAI_API_KEY="<REDACTED_SET_VIA_ENV>" \
qwen -m "deepseek-chat" "$@"
