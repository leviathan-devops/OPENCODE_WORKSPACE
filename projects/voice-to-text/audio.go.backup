package main

import (
	"encoding/json"
	"fmt"
	"log"
	"math"
	"os"
	"os/exec"
	"strings"
	"sync"
	"time"

	vosk "github.com/alphacep/vosk-api/go"
	"github.com/gordonklaus/portaudio"
)

// notify sends a desktop notification using notify-send
func notify(title, message string) {
	log.Printf("Notification: %s - %s", title, message)
	cmd := exec.Command("notify-send", title, message)
	if err := cmd.Run(); err != nil {
		log.Printf("Failed to send notification: %v", err)
		// Fallback: log to status file
		statusMsg := fmt.Sprintf("[%s] %s: %s", time.Now().Format("15:04:05"), title, message)
		if err := os.WriteFile("/tmp/voice-to-text-status.log", []byte(statusMsg+"\n"), 0644); err != nil {
			log.Printf("Failed to write status file: %v", err)
		}
	}
}

// typeText types the given text into the currently focused window using xdotool
func typeText(text string) {
	if text == "" {
		return
	}
	// Clean up text: remove extra whitespace, newlines
	cleanText := strings.TrimSpace(text)
	// Replace newlines with spaces
	cleanText = strings.ReplaceAll(cleanText, "\n", " ")
	// Collapse multiple spaces
	cleanText = strings.Join(strings.Fields(cleanText), " ")

	if cleanText == "" {
		return
	}

	log.Printf("Typing text: %s", cleanText)

	// Simple xdotool typing with DISPLAY set
	cmd := exec.Command("xdotool", "type", "--clearmodifiers", cleanText)
	cmd.Env = append(os.Environ(), "DISPLAY=:0")

	if err := cmd.Run(); err != nil {
		log.Printf("Failed to type text: %v", err)
		// Fallback: print to console
		fmt.Printf("\n[Would type: %s]\n", cleanText)
	}
}

// transcribeWithPython uses arecord to capture and transcribe
func transcribeWithPython() string {
	log.Printf("Starting audio capture and transcription...")

	// Record audio using arecord in mono format
	audioFile := "/tmp/voice-record.wav"
	recordCmd := exec.Command("arecord", "-d", "3", "-f", "cd", "-r", "16000", "-c", "1", audioFile)
	recordCmd.Env = append(os.Environ(), "DISPLAY=:0")

	if err := recordCmd.Run(); err != nil {
		log.Printf("Failed to record audio: %v", err)
		return ""
	}

	// Check if file was created
	if _, err := os.Stat(audioFile); os.IsNotExist(err) {
		log.Printf("Audio file not created")
		return ""
	}

	// Simple transcription using vosk from Python
	pythonScript := fmt.Sprintf(`
import json
import sys
from vosk import Model, KaldiRecognizer
import wave

audio_file = "%s"
model_path = "/usr/local/share/voice-to-text/vosk-model-small-en-us-0.15"

try:
    wf = wave.open(audio_file, "rb")
    print(f"Audio: channels={wf.getnchannels()}, sampwidth={wf.getsampwidth()}, rate={wf.getframerate()}", file=sys.stderr)
    
    model = Model(model_path)
    rec = KaldiRecognizer(model, wf.getframerate())
    
    text_parts = []
    
    while True:
        data = wf.readframes(4000)
        if len(data) == 0:
            break
        if rec.AcceptWaveform(data):
            result = json.loads(rec.Result())
            if 'text' in result and result['text']:
                text_parts.append(result['text'])
        else:
            partial = json.loads(rec.PartialResult())
            if 'partial' in partial and partial['partial']:
                sys.stderr.write(f"\\rPartial: {partial['partial']}")
    
    # Final result
    result = json.loads(rec.FinalResult())
    if 'text' in result and result['text']:
        text_parts.append(result['text'])
    
    # Combine all text parts
    full_text = " ".join(text_parts)
    print(full_text)
        
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    print("")
`, audioFile)

	// Run Python transcription with virtual environment
	cmd := exec.Command("/tmp/voice-venv/bin/python", "-c", pythonScript)
	cmd.Env = append(os.Environ(), "DISPLAY=:0")

	output, err := cmd.Output()
	if err != nil {
		log.Printf("Python transcription failed: %v", err)
		// Clean up
		os.Remove(audioFile)
		return ""
	}

	text := strings.TrimSpace(string(output))
	// Clean up
	os.Remove(audioFile)

	if text != "" {
		log.Printf("Transcription: %s", text)
	} else {
		log.Printf("No transcription result")
	}
	return text
}

// parseVoskResult extracts text from Vosk JSON result
func parseVoskResult(jsonStr string) string {
	if jsonStr == "" {
		return ""
	}

	// Debug: log raw JSON for analysis
	if strings.HasPrefix(jsonStr, "{") && strings.HasSuffix(jsonStr, "}") {
		log.Printf("Parsing JSON: %s", jsonStr)
	}

	// Define a struct to match Vosk JSON output with alternatives
	var result struct {
		Text    string `json:"text"`
		Partial string `json:"partial"`
		Result  []struct {
			Conf float64 `json:"conf"`
			Word string  `json:"word"`
		} `json:"result"`
	}
	if err := json.Unmarshal([]byte(jsonStr), &result); err != nil {
		// Fallback: try to extract text directly
		log.Printf("JSON parse error: %v, raw: %s", err, jsonStr)
		// Simple extraction: look for "text" field
		if idx := strings.Index(jsonStr, `"text":"`); idx != -1 {
			endIdx := strings.Index(jsonStr[idx+8:], `"`)
			if endIdx != -1 {
				return jsonStr[idx+8 : idx+8+endIdx]
			}
		}
		// Try partial field
		if idx := strings.Index(jsonStr, `"partial":"`); idx != -1 {
			endIdx := strings.Index(jsonStr[idx+11:], `"`)
			if endIdx != -1 {
				return jsonStr[idx+11 : idx+11+endIdx]
			}
		}
		return ""
	}

	// Use result.Text if available
	if result.Text != "" {
		log.Printf("Found text: %s", result.Text)
		return result.Text
	}

	// If we have alternatives, use the highest confidence one
	if len(result.Result) > 0 {
		// Build text from words
		var words []string
		for _, word := range result.Result {
			words = append(words, word.Word)
		}
		text := strings.Join(words, " ")
		log.Printf("Built text from result: %s", text)
		return text
	}

	log.Printf("Using partial: %s", result.Partial)
	return result.Partial
}

// AudioCapture handles audio recording and speech recognition
type AudioCapture struct {
	mu           sync.Mutex
	recording    bool
	model        *vosk.VoskModel
	rec          *vosk.VoskRecognizer
	hardwareRate float64 // Actual sample rate supported by hardware
	resamplePos  float64 // Position in input stream for resampling (fractional sample index)
	lastSample   int16   // Last input sample for interpolation

	// Audio buffer for final transcription
	audioBuffer [][]int16
}

// detectSampleRate tries common sample rates and returns the first supported one
func detectSampleRate() (float64, error) {
	// Common audio sample rates to try (most hardware supports these)
	rates := []float64{44100.0, 48000.0, 96000.0, 88200.0, 32000.0, 22050.0}

	for _, rate := range rates {
		// Try to open a test stream with this rate
		in := make([]int16, 1024)
		stream, err := portaudio.OpenDefaultStream(1, 0, rate, len(in), in)
		if err == nil {
			stream.Close()
			log.Printf("Detected supported sample rate: %.0f Hz", rate)
			return rate, nil
		}
		log.Printf("Sample rate %.0f Hz not supported: %v", rate, err)
	}

	return 0, fmt.Errorf("no supported sample rate found (tried %v)", rates)
}

// NewAudioCapture creates and initializes audio capture with Vosk
func NewAudioCapture() (*AudioCapture, error) {
	// Initialize PortAudio
	if err := portaudio.Initialize(); err != nil {
		return nil, fmt.Errorf("PortAudio init error: %v", err)
	}

	// Detect supported sample rate
	hardwareRate, err := detectSampleRate()
	if err != nil {
		portaudio.Terminate()
		return nil, fmt.Errorf("failed to detect sample rate: %v", err)
	}
	log.Printf("Using hardware sample rate: %.0f Hz", hardwareRate)

	// Load Vosk model
	modelPath := "/usr/local/share/voice-to-text/vosk-model-small-en-us-0.15"
	log.Printf("Loading Vosk model from %s...", modelPath)
	model, err := vosk.NewModel(modelPath)
	if err != nil {
		portaudio.Terminate()
		return nil, fmt.Errorf("Failed to load Vosk model: %v", err)
	}

	// Create recognizer
	rec, err := vosk.NewRecognizer(model, 16000.0)
	if err != nil {
		model.Free()
		portaudio.Terminate()
		return nil, fmt.Errorf("Failed to create recognizer: %v", err)
	}
	rec.SetMaxAlternatives(1) // Get 1 alternative for better accuracy
	rec.SetWords(1)

	ac := &AudioCapture{
		model:        model,
		rec:          rec,
		hardwareRate: hardwareRate,
		audioBuffer:  make([][]int16, 0),
	}
	return ac, nil
}

// StartRecording begins audio capture and transcription
func (ac *AudioCapture) StartRecording() error {
	ac.mu.Lock()
	defer ac.mu.Unlock()

	if ac.recording {
		return fmt.Errorf("already recording")
	}
	ac.recording = true

	go ac.captureAudio()
	return nil
}

// StopRecording stops audio capture
func (ac *AudioCapture) StopRecording() error {
	ac.mu.Lock()
	defer ac.mu.Unlock()

	if !ac.recording {
		return fmt.Errorf("not recording")
	}
	ac.recording = false
	return nil
}

// captureAudio runs in a goroutine and captures audio
func (ac *AudioCapture) captureAudio() {
	// Ensure recording flag is reset on exit
	defer func() {
		ac.mu.Lock()
		ac.recording = false
		ac.mu.Unlock()
		log.Println("Audio capture stopped")
		notify("Voice-to-Text", "Recording stopped")
	}()

	// Notify user
	notify("Voice-to-Text", "Recording started... Speak now")

	// Open audio stream at hardware-supported sample rate
	in := make([]int16, 1024) // framesPerBuffer = 1024
	stream, err := portaudio.OpenDefaultStream(1, 0, ac.hardwareRate, len(in), in)
	if err != nil {
		log.Printf("Failed to open audio stream: %v", err)
		log.Printf("Trying alternative: using arecord to test microphone...")
		// Test if microphone works with arecord
		testCmd := exec.Command("arecord", "-d", "1", "-f", "cd", "/tmp/mic-test.wav")
		if testErr := testCmd.Run(); testErr != nil {
			log.Printf("arecord also failed: %v - microphone may not be accessible", testErr)
		} else {
			log.Printf("arecord succeeded - microphone works but PortAudio can't access it")
		}
		return
	}
	if err != nil {
		log.Printf("Audio stream error: %v", err)
		return
	}
	defer stream.Close()

	if err := stream.Start(); err != nil {
		log.Printf("Audio start error: %v", err)
		return
	}

	ac.mu.Lock()
	recording := ac.recording
	ac.mu.Unlock()

	log.Printf("Audio capture started at %.0f Hz", ac.hardwareRate)

	for recording {
		if err := stream.Read(); err != nil {
			log.Printf("Audio read error: %v", err)
			break
		}

		// Resample from hardware rate to 16000 Hz for Vosk
		resampled := ac.resampleBuffer(in)
		if len(resampled) == 0 {
			// Not enough data yet, continue
			continue
		}

		// Apply audio processing for better recognition
		// 1. Apply stronger gain (+12dB) to boost quiet speech
		resampled = applyGain(resampled, 12.0)
		// 2. Use very light noise gate (-20dB) to reduce noise without removing speech
		resampled = noiseGate(resampled, -20.0)

		// Convert to bytes
		audioBytes := int16ToBytes(resampled)

	// Feed to recognizer but don't type automatically
	acceptResult := ac.rec.AcceptWaveform(audioBytes)
	
	if acceptResult != 0 {
		// Utterance complete - just log it
		result := ac.rec.Result()
		log.Printf("Vosk utterance complete, result length: %d", len(result))
	}
		}

		// Store audio for later transcription
		ac.mu.Lock()
		ac.audioBuffer = append(ac.audioBuffer, resampled)
		// Keep only last 10 seconds of audio to avoid memory issues
		if len(ac.audioBuffer) > 100 {
			ac.audioBuffer = ac.audioBuffer[len(ac.audioBuffer)-100:]
		}
		ac.mu.Unlock()

		// Always check for partial results and type them immediately
		partial := ac.rec.PartialResult()
		if partial != "" && partial != `{"partial" : ""}` {
			text := parseVoskResult(partial)
			if text != "" {
				fmt.Printf("\rListening: %s", text)
				// Type partial results as they come
				typeText(text + " ")
			}
		}

		if acceptResult != 0 {
			// Utterance complete
			result := ac.rec.Result()
			log.Printf("Vosk utterance complete, result length: %d", len(result))
			if result != "" {
				text := parseVoskResult(result)
				if text != "" {
					fmt.Printf("\nResult: %s\n", text)
					notify("Voice-to-Text", "Transcription: "+text)
					typeText(text + " ")
				}
			}
		}

		// Check if recording stopped
		ac.mu.Lock()
		recording = ac.recording
		ac.mu.Unlock()
	}

	// Finalize - transcribe the recorded audio
	ac.mu.Lock()
	if len(ac.audioBuffer) > 0 {
		// Combine all audio buffers
		var allAudio []int16
		for _, buf := range ac.audioBuffer {
			allAudio = append(allAudio, buf...)
		}
		
		if len(allAudio) > 0 {
			// Save to file and transcribe
			audioFile := "/tmp/voice-final.wav"
			audioBytes := int16ToBytes(allAudio)
			
			// Write WAV file
			wavHeader := createWavHeader(len(audioBytes), 16000, 1)
			if err := os.WriteFile(audioFile, append(wavHeader, audioBytes...), 0644); err == nil {
				// Transcribe using Python
				text := transcribeAudioFile(audioFile)
				if text != "" && text != "[speech]" {
					fmt.Printf("\nTranscription: %s\n", text)
					notify("Voice-to-Text", "Transcription: "+text)
					typeText(text + " ")
				} else if text == "[speech]" {
					// Don't type placeholder
					fmt.Printf("\nNo clear speech detected\n")
				}
				os.Remove(audioFile)
			}
		}
		// Clear buffer
		ac.audioBuffer = make([][]int16, 0)
	}
	ac.mu.Unlock()

	stream.Stop()
	log.Println("Audio stream stopped.")
}

// Close cleans up resources
func (ac *AudioCapture) Close() {
	ac.mu.Lock()
	defer ac.mu.Unlock()

	if ac.recording {
		ac.recording = false
	}
	if ac.rec != nil {
		ac.rec.Free()
		ac.rec = nil
	}
	if ac.model != nil {
		ac.model.Free()
		ac.model = nil
	}
	portaudio.Terminate()
}

// resampleBuffer converts audio from hardware sample rate to 16000 Hz for Vosk
func (ac *AudioCapture) resampleBuffer(input []int16) []int16 {
	if len(input) == 0 {
		return nil
	}

	// Ratio = input sample rate / output sample rate
	ratio := ac.hardwareRate / 16000.0

	// Estimate output size: input length / ratio, plus some margin
	outputEstimate := int(float64(len(input))/ratio) + 2
	output := make([]int16, 0, outputEstimate)

	// Process each output sample
	for ac.resamplePos < float64(len(input)) {
		idx := int(ac.resamplePos)
		frac := ac.resamplePos - float64(idx)

		// Get current and next sample for interpolation
		var current, next int16
		if idx < len(input) {
			current = input[idx]
		} else {
			// Beyond buffer, use last sample
			current = ac.lastSample
		}

		if idx+1 < len(input) {
			next = input[idx+1]
		} else {
			next = current
		}

		// Linear interpolation with clamping
		interpolated := float64(current)*(1-frac) + float64(next)*frac
		// Clamp to int16 range
		if interpolated > 32767.0 {
			interpolated = 32767.0
		}
		if interpolated < -32768.0 {
			interpolated = -32768.0
		}
		output = append(output, int16(math.Round(interpolated)))

		// Move forward in input stream by ratio
		ac.resamplePos += ratio
	}

	// Store last sample for next buffer
	ac.lastSample = input[len(input)-1]

	// Keep fractional position beyond buffer for next call
	ac.resamplePos -= float64(len(input))

	return output
}

// applyGain applies gain to audio buffer
func applyGain(input []int16, gainDB float64) []int16 {
	if len(input) == 0 {
		return input
	}

	// Convert dB to linear gain
	gainLinear := math.Pow(10.0, gainDB/20.0)

	output := make([]int16, len(input))
	for i, sample := range input {
		// Apply gain with clamping
		scaled := float64(sample) * gainLinear
		if scaled > 32767.0 {
			scaled = 32767.0
		}
		if scaled < -32768.0 {
			scaled = -32768.0
		}
		output[i] = int16(math.Round(scaled))
	}
	return output
}

// noiseGate applies a simple noise gate to remove background noise
func noiseGate(input []int16, thresholdDB float64) []int16 {
	if len(input) == 0 {
		return input
	}

	// Convert threshold from dB to linear amplitude
	// -40dB is very quiet, might be filtering out speech
	// Use -20dB instead for testing
	thresholdLinear := math.Pow(10.0, thresholdDB/20.0) * 32768.0
	log.Printf("Noise gate threshold: %.2f (%.2f dB)", thresholdLinear, thresholdDB)

	output := make([]int16, len(input))
	zeroedCount := 0

	// Simple noise gate: zero out samples below threshold
	for i, sample := range input {
		absSample := math.Abs(float64(sample))
		if absSample < thresholdLinear {
			output[i] = 0
			zeroedCount++
		} else {
			output[i] = sample
		}
	}

	log.Printf("Noise gate: zeroed %d/%d samples (%.1f%%)", zeroedCount, len(input), float64(zeroedCount)/float64(len(input))*100)
	return output
}

func int16ToBytes(s []int16) []byte {
	buf := make([]byte, len(s)*2)
	for i, v := range s {
		buf[i*2] = byte(v)
		buf[i*2+1] = byte(v >> 8)
	}
	return buf
}
