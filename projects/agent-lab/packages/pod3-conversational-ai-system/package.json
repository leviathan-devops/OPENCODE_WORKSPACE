{
  "name": "@agent-lab/pod3",
  "version": "0.1.0",
  "description": "Conversational AI System for Agent Lab",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@agent-lab/shared": "workspace:*",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "openai": "^4.68.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}