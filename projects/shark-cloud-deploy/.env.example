# Shark Cloud Environment Variables

# ── OpenCode / LLM Provider ───────────────────────────────────────────────────
# API key for LLM provider (minimax is default)
MINIMAX_API_KEY=sk-your-key-here

# Alternative providers (if using custom OpenCode config)
DEEPSEEK_API_KEY=sk-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ── Discord Bot ────────────────────────────────────────────────────────────────
# Bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your-discord-bot-token

# ── Mattermost ────────────────────────────────────────────────────────────────
# Mattermost webhook URL for bot integration
MATTERMOST_WEBHOOK_URL=https://your-mattermost-server.com/api/v4/hooks/your-hook-id

# ── Shark Cloud Service ────────────────────────────────────────────────────────
PORT=3000
SHARK_WORKSPACE=/workspace
SESSION_TIMEOUT_MS=300000
MAX_CONCURRENT_TASKS=3

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
