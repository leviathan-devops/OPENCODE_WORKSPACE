{
  "name": "nemotron-communication-layer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:stage1": "vitest run --reporter=json --outputFile=.shark/test-results/stage1.json tests/unit",
