{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "restartable": true
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "readinessCheckType": "HTTP",
    "readinessCheck": {
      "path": "/health",
      "port": 5000
    }
  },
  "environment": {
    "production": {
      "region": "us-west"
    }
  }
}
