#### Smart Compaction Logic Implementation
```python
# File: /home/leviathan/OPENCODE_WORKSPACE/OPENCODE_WORKSPACE/openviking-smart-compaction.py
import json
import re
from typing import List, Dict, Tuple

class SmartCompactor:
    def __init__(self, config: Dict):
        self.config = config
        self.instruction_keywords = [
            'def ', 'class ', 'import ', 'from ', 'function ', 'method ',
            'print(', 'return ', 'if ', 'else:', 'for ', 'while ',
            '# TODO:', '# FIXME:', '# NOTE:', '//', '/*'
        ]
        
    def should_preserve(self, token: str, context: str) -> bool:
        """Determine if a token should be preserved during compaction"""
        # Preserve instructions and code
        for keyword in self.instruction_keywords:
            if keyword in token.lower():
                return True
                
        # Preserve user's recent requests
        if any(phrase in token.lower() for phrase in 
               ['explain ', 'help me', 'write ', 'create ', 'debug ']):
            return True
            
        # Preserve error messages
        if any(word in token.lower() for word in 
               ['error:', 'exception:', 'traceback:', 'failed']):
            return True
            
        return False
    
    def smart_compress(self, context: str, max_length: int) -> str:
        """Intelligently compress context while preserving important information"""
        if len(context) <= max_length:
            return context
            
        # Split into lines/tokens
        lines = context.split('\n')
        compressed_lines = []
        current_length = 0
        
        # First pass: preserve important lines
        for line in lines:
            if (current_length + len(line) <= max_length or 
                self.should_preserve(line, context)):
                compressed_lines.append(line)
                current_length += len(line) + 1  # +1 for newline
                
        # Second pass: if still over, apply gentle compression
        if current_length > max_length:
            compressed_lines = self.gentle_compress(compressed_lines, max_length)
            
        return '\n'.join(compressed_lines)
    
    def gentle_compress(self, lines: List[str], max_length: int) -> List[str]:
        """Apply compression that preserves meaning"""
        compressed = []
        current = ""
        
        for line in lines:
            if len(current) + len(line) + 1 <= max_length:
                current += line + '\n'
            else:
                if current:
                    compressed.append(current.rstrip('\n'))
                # Add remaining lines if they fit
                if len(line) <= max_length:
                    compressed.append(line)
                else:
                    # Truncate very long lines
                    compressed.append(line[:max_length-3] + '...')
                    
        return compressed

# Integration with OpenViking
def apply_smart_compaction(openviking_request: Dict) -> Dict:
    compactor = SmartCompactor(openviking_request.get('config', {}))
    
    if 'messages' in openviking_request:
        # Apply compaction to conversation history
        messages = openviking_request['messages']
        max_context = openviking_request.get('max_context_length', 32768)
        
        # Extract conversation context
        context = '\n'.join([
            f"{msg['role']}: {msg['content']}" 
            for msg in messages[:-1]  # Exclude current message
        ])
        
        # Apply smart compression
        compressed_context = compactor.smart_compress(context, max_context * 0.8)
        
        # Update messages with compressed context
        if len(messages) > 1:
            compressed_messages = [
                messages[0],  # Keep system message
                {
                    "role": "assistant", 
                    "content": f"[Context from previous conversation compressed below]\n{compressed_context}"
                }
            ] + messages[2:]  # Keep current user message
            openviking_request['messages'] = compressed_messages
            
    return openviking_request
```

