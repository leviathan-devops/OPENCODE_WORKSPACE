400: ## Test Runner Implementation
401: 
402: ```typescript
403: // src/tests/kraken-test-runner.ts
404: 
405: interface TestResult {
406:   name: string;
407:   category: string;
408:   status: 'pass' | 'fail' | 'error';
409:   durationMs: number;
410:   input: any;
411:   expected: any;
412:   actual: any;
413:   evidence: Record<string, any>;
414:   timestamp: string;
415: }
416: 
417: interface TestCase {
418:   name: string;
419:   category: string;
420:   test: () => Promise<TestResult>;
421: }
422: 
423: export class KrakenTestRunner {
424:   private results: TestResult[] = [];
425:   private startTime: number = 0;
426:   
427:   async runAll(tests: TestCase[]): Promise<TestResult[]> {
428:     this.startTime = Date.now();
429:     this.results = [];
430:     
431:     for (const testCase of tests) {
432:       const result = await this.runTest(testCase);
433:       this.results.push(result);
434:       
435:       // Fail-fast on critical failures
436:       if (result.status === 'fail' && testCase.category === 'ISOLATION') {
437:         console.log(`CRITICAL FAILURE in ${testCase.name} - stopping`);
438:         break;
439:       }
440:     }
441:     
442:     return this.results;
443:   }
444:   
445:   private async runTest(testCase: TestCase): Promise<TestResult> {
446:     const start = Date.now();
447:     
448:     try {
449:       const result = await testCase.test();
450:       return {
451:         ...result,
452:         durationMs: Date.now() - start,
453:         timestamp: new Date().toISOString(),
454:       };
455:     } catch (error) {
456:       return {
457:         name: testCase.name,
458:         category: testCase.category,
459:         status: 'error',
460:         durationMs: Date.now() - start,
461:         input: null,
462:         expected: null,
463:         actual: error,
464:         evidence: { error: String(error) },
465:         timestamp: new Date().toISOString(),
466:       };
467:     }
468:   }
469:   
470:   generateReport(): string {
471:     const passed = this.results.filter(r => r.status === 'pass').length;
472:     const failed = this.results.filter(r => r.status === 'fail').length;
473:     const errors = this.results.filter(r => r.status === 'error').length;
474:     const total = this.results.length;
475:     const duration = Date.now() - this.startTime;
476:     
477:     let report = `# KRAKEN TEST REPORT
478: Generated: ${new Date().toISOString()}
479: Duration: ${duration}ms
480: 
481: ## SUMMARY
482: | Status | Count |
483: |--------|-------|
484: | PASS   | ${passed} |
485: | FAIL   | ${failed} |
486: | ERROR  | ${errors} |
487: | TOTAL  | ${total} |
488: 
489: ## BY CATEGORY
490: `;
491:     
492:     const byCategory = new Map<string, TestResult[]>();
493:     for (const result of this.results) {
494:       const existing = byCategory.get(result.category) || [];
495:       existing.push(result);
496:       byCategory.set(result.category, existing);
497:     }
498:     
499:     for (const [category, results] of byCategory) {
500:       const categoryPassed = results.filter(r => r.status === 'pass').length;
501:       report += `\n### ${category} (${categoryPassed}/${results.length} passed)\n`;
502:       
503:       for (const result of results) {
504:         const icon = result.status === 'pass' ? '✅' : result.status === 'fail' ? '❌' : '💥';
505:         report += `${icon} ${result.name} (${result.durationMs}ms)\n`;
506:         
507:         if (result.status !== 'pass') {
508:           report += `   Input: ${JSON.stringify(result.input)}\n`;
509:           report += `   Expected: ${JSON.stringify(result.expected)}\n`;
510:           report += `   Actual: ${JSON.stringify(result.actual)}\n`;
511:           report += `   Evidence: ${JSON.stringify(result.evidence)}\n`;
512:         }
513:       }
514:     }
515:     
516:     return report;
517:   }
518:   
519:   saveArtifacts(outputDir: string): void {
520:     const fs = require('fs');
521:     const path = require('path');
522:     
523:     // Save JSON results
524:     const jsonPath = path.join(outputDir, 'test-results.json');
525:     fs.writeFileSync(jsonPath, JSON.stringify(this.results, null, 2));
526:     
527:     // Save markdown report
528:     const mdPath = path.join(outputDir, 'test-report.md');
529:     fs.writeFileSync(mdPath, this.generateReport());
530:     
531:     // Save individual evidence files
532:     for (const result of this.results) {
533:       if (result.evidence && Object.keys(result.evidence).length > 0) {
534:         const evidencePath = path.join(outputDir, 'evidence', `${result.name}.json`);
535:         fs.writeFileSync(evidencePath, JSON.stringify(result.evidence, null, 2));
536:       }
537:     }
538:   }
539: }
540: ```
