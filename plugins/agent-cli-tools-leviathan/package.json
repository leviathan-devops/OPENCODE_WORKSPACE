{
  "name": "agent-cli-tools-leviathan",
  "version": "0.1.0",
  "description": "Universal Gemini and Qwen CLI tools for OpenCode - Leviathan Build",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun build src/index.ts --outdir dist --target bun --format esm && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.1.53",
    "@opencode-ai/sdk": "^1.1.53"
  },
  "dependencies": {
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.1.53",
    "@opencode-ai/sdk": "^1.1.53",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "bun-types": "latest",
    "typescript": "^5.7.3"
  }
}
